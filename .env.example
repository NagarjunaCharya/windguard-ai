# ============================================================================
# WindGuard AI - Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env file to version control!
# ============================================================================

# Application Settings
APP_NAME="WindGuard AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# EnOS IoT Platform Credentials
# Get these from: https://www.envisioniot.com/
ENOS_APP_KEY="YOUR_ENOS_APP_KEY_HERE"
ENOS_APP_SECRET="YOUR_ENOS_APP_SECRET_HERE"
ENOS_ORG_ID="YOUR_ORGANIZATION_ID_HERE"
ENOS_API_URL="https://api.envisioniot.com"

# Database Configuration (Optional)
DATABASE_URL="postgresql://user:password@localhost:5432/windguard"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration (Optional)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# ML Model Configuration
MODEL_PATH="data/models/bilstm_model.pth"
SCALER_PATH="data/processed/scaler.pkl"
PREDICTION_HORIZON_HOURS=72
SEQUENCE_LENGTH=24

# Data Configuration
DATA_DIR="data"
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
MODELS_DIR="data/models"

# Kaggle API (Optional - for dataset download)
# Get from: https://www.kaggle.com/account
KAGGLE_USERNAME="your_kaggle_username"
KAGGLE_KEY="your_kaggle_api_key"

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="logs/windguard.log"

# Security (Production)
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500"
CORS_ALLOW_CREDENTIALS=true

# Alert Thresholds
VIBRATION_ALERT_THRESHOLD=3.0
TEMPERATURE_ALERT_THRESHOLD=70.0
POWER_DROP_THRESHOLD=0.8

# Email Notifications (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
ALERT_EMAIL="alerts@windguard-ai.com"

# Monitoring (Optional)
SENTRY_DSN=""
DATADOG_API_KEY=""

# Feature Flags
ENABLE_REAL_TIME_PREDICTION=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_EMAIL_ALERTS=false
ENABLE_DIGITAL_TWIN=false

# OpenFAST Configuration
OPENFAST_BINARY_PATH="external_repos/OpenFAST/build/glue-codes/openfast/openfast.exe"
OPENFAST_INPUT_DIR="external_repos/OpenFAST/reg_tests/r-test/glue-codes/openfast"
