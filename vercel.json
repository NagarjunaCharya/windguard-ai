{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/windguard-frontend/production/windguard-dashboard.html"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/windguard-dashboard.html",
      "destination": "/windguard-frontend/production/windguard-dashboard.html"
    },
    {
      "source": "/ar-guide.html",
      "destination": "/windguard-frontend/production/ar-guide.html"
    },
    {
      "source": "/:path*",
      "destination": "/windguard-frontend/production/:path*"
    }
  ]
}
